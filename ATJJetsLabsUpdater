# =============================================================================
# Deploy-GarminData-GDrive.ps1 (Deep Freeze Cloud / SYSTEM Context)
# =============================================================================
$ErrorActionPreference = "Stop"
$ProgressPreference    = "SilentlyContinue"

# Force TLS 1.2
try {
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
} catch { }

function Write-Log {
    param([string]$Message)
    Write-Output "[$((Get-Date).ToString('yyyy-MM-dd HH:mm:ss'))] $Message"
}

# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------
$DestinationFolder = "C:\X-Plane 12\Custom Data"
$FileId            = "1hObAdYNqVTPnmggl4djK3pdskmz3o5hr"

# Targeted files and directories to extract and copy
$TargetItems = @(
    "CIFP",
    "earth_fix.dat",
    "earth_awy.dat",
    "earth_nav.dat",
    "earth_hold.dat",
    "earth_mora.dat",
    "earth_msa.dat"
)

# Parse parameters passed via Deep Freeze Cloud
if ($args.Count -gt 0) {
    $rawArgs = $args -join " "
    if ($rawArgs -match 'id=([a-zA-Z0-9_-]+)') {
        $FileId = $matches[1]
    }
}

Write-Log "Starting deployment to: $DestinationFolder"
Write-Log "Target Google Drive File ID: $FileId"

# -----------------------------------------------------------------------------
# 1. Directory Check
# -----------------------------------------------------------------------------
if (-not (Test-Path -LiteralPath $DestinationFolder)) {
    Write-Log "Creating destination directory: $DestinationFolder"
    New-Item -Path $DestinationFolder -ItemType Directory -Force | Out-Null
}

$tempZip     = Join-Path $env:TEMP ("gdrive_" + [Guid]::NewGuid().ToString("N") + ".zip")
$tempCookie  = Join-Path $env:TEMP ("cookie_" + [Guid]::NewGuid().ToString("N") + ".txt")
$tempExtract = Join-Path $env:TEMP ("extract_" + [Guid]::NewGuid().ToString("N"))

# -----------------------------------------------------------------------------
# 2. Download from Google Drive (API Direct Stream & Token Bypass)
# -----------------------------------------------------------------------------
try {
    Write-Log "Downloading ZIP package from Google Drive..."
    
    # Download attempt via direct export URL
    $baseUrl = "https://drive.google.com/uc?export=download&id=$FileId"
    
    # Save response and cookies using curl
    & curl.exe -s -L -c "$tempCookie" "$baseUrl" -o "$tempZip"

    # Inspect downloaded payload header to see if it's an HTML virus scan page
    $firstBytes = [System.IO.File]::ReadAllText($tempZip)
    if ($firstBytes -match '<!DOCTYPE html' -or $firstBytes -match '<html') {
        Write-Log "Virus scan warning page detected. Extracting confirmation token..."
        
        # Regex search for all current variants of Google Drive confirm tokens
        $confirmToken = ""
        if ($firstBytes -match 'confirm=([0-9A-Za-z_\-]+)') {
            $confirmToken = $matches[1]
        } elseif ($firstBytes -match 'name="confirm" value="([0-9A-Za-z_\-]+)"') {
            $confirmToken = $matches[1]
        } elseif ($firstBytes -match 'uuid=([0-9A-Za-z_\-]+)') {
            $confirmToken = $matches[1]
        }

        if ($confirmToken) {
            Write-Log "Confirm token retrieved ($confirmToken). Re-requesting direct file stream..."
            $confirmUrl = "https://drive.google.com/uc?export=download&confirm=$confirmToken&id=$FileId"
            & curl.exe -s -L -b "$tempCookie" "$confirmUrl" -o "$tempZip"
        } else {
            # Fallback: Direct API Endpoint bypass
            Write-Log "Attempting Direct Google Drive API bypass stream..."
            $apiUrl = "https://www.googleapis.com/drive/v3/files/${FileId}?alt=media"
            & curl.exe -s -L "$apiUrl" -o "$tempZip"
        }
    }

    # Verify that the downloaded file is a valid ZIP archive (Magic Header: PK..)
    $bytes = Get-Content -Path $tempZip -Encoding Byte -TotalCount 2 -ErrorAction SilentlyContinue
    if (-not ($bytes[0] -eq 0x50 -and $bytes[1] -eq 0x4B)) {
        throw "Downloaded payload is not a valid ZIP file. Ensure Google Drive permissions are set to 'Anyone with the link'."
    }

    $finalSize = (Get-Item $tempZip).Length
    Write-Log "Download stream finished successfully. ZIP Size: $finalSize bytes."

} catch {
    Write-Log "ERROR: Google Drive download failed. Details: $_"
    Remove-Item -Path $tempZip, $tempCookie -Force -ErrorAction SilentlyContinue
    exit 1
}

# -----------------------------------------------------------------------------
# 3. Extract Archive & Copy Selected Items
# -----------------------------------------------------------------------------
try {
    Write-Log "Extracting ZIP contents..."
    Expand-Archive -Path $tempZip -DestinationPath $tempExtract -Force

    foreach ($itemName in $TargetItems) {
        $foundItems = Get-ChildItem -Path $tempExtract -Filter $itemName -Recurse -ErrorAction SilentlyContinue

        if ($foundItems) {
            foreach ($item in $foundItems) {
                $targetDest = Join-Path $DestinationFolder $item.Name
                Write-Log "Deploying: $($item.Name) -> $targetDest"
                
                if ($item.PSIsContainer) {
                    Copy-Item -Path $item.FullName -Destination $DestinationFolder -Recurse -Force
                } else {
                    Copy-Item -Path $item.FullName -Destination $targetDest -Force
                }
            }
        } else {
            Write-Log "WARNING: Item '$itemName' was not found in the ZIP package."
        }
    }

    Write-Log "Deployment completed successfully!"
    exit 0
} catch {
    Write-Log "ERROR: Extraction or file deployment failed. $_"
    exit 3
} finally {
    Remove-Item -Path $tempZip, $tempCookie -Force -ErrorAction SilentlyContinue
    Remove-Item -Path $tempExtract -Recurse -Force -ErrorAction SilentlyContinue
}
