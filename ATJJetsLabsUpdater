# =============================================================================
# Deploy-GarminData.ps1 (Deep Freeze Cloud / SYSTEM Context Optimized)
# =============================================================================
$ErrorActionPreference = "Stop"
$ProgressPreference    = "SilentlyContinue"

# Force TLS 1.2
try {
    [Net.ServicePointManager]::SecurityProtocol = `
        [Net.SecurityProtocolType]::Tls12
} catch { }

function Write-Log {
    param([string]$Message)
    Write-Output "[$((Get-Date).ToString('yyyy-MM-dd HH:mm:ss'))] $Message"
}

# -----------------------------------------------------------------------------
# Configuration (Supports Command Line Arguments & Defaults)
# -----------------------------------------------------------------------------
$DestinationFolder = "C:\X-Plane 12\Custom Data"
$FileId            = "1CHt_W9PP_nhhO1YbPV8fjGno39C-V5Hh" # Default target File ID

# Targeted files and directories to extract and copy
$TargetItems = @(
    "CIFP",
    "earth_fix.dat",
    "earth_awy.dat",
    "earth_nav.dat",
    "earth_hold.dat",
    "earth_mora.dat",
    "earth_msa.dat"
)

# Check if -DownloadUrl was passed in $args
for ($i = 0; $i -lt $args.Count; $i++) {
    if ($args[$i] -eq "-DownloadUrl" -and ($i + 1) -lt $args.Count) {
        $passedUrl = $args[$i + 1]
        if ($passedUrl -match 'id=([a-zA-Z0-9_-]+)') {
            $FileId = $matches[1]
        }
    }
}

Write-Log "Starting deployment to: $DestinationFolder"
Write-Log "Target File ID         : $FileId"

# -----------------------------------------------------------------------------
# 1. Ensure Target Directory Exists
# -----------------------------------------------------------------------------
try {
    if (-not (Test-Path -LiteralPath $DestinationFolder)) {
        Write-Log "Creating destination directory: $DestinationFolder"
        New-Item -Path $DestinationFolder -ItemType Directory -Force | Out-Null
    }
} catch {
    Write-Log "ERROR: Failed to create target directory. $_"
    exit 2
}

# -----------------------------------------------------------------------------
# 2. Download from Google Drive (Handles SYSTEM context & Confirm Tokens)
# -----------------------------------------------------------------------------
$tempZip     = Join-Path $env:TEMP ("gdrive_" + [Guid]::NewGuid().ToString("N") + ".zip")
$tempExtract = Join-Path $env:TEMP ("extract_" + [Guid]::NewGuid().ToString("N"))

try {
    Write-Log "Downloading from Google Drive..."
    
    $baseUrl = "https://drive.google.com/uc?export=download&id=$FileId"
    $wc = New-Object System.Net.WebClient
    $wc.Headers.Add("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64)")
    
    # First attempt
    $wc.DownloadFile($baseUrl, $tempZip)
    
    # Check if we received HTML instead of the file (Google's virus warning page)
    $fileInfo = Get-Item $tempZip
    if ($fileInfo.Length -lt 100000) {
        $content = [System.IO.File]::ReadAllText($tempZip)
        
        # Updated regex to capture token from modern Google Drive warning pages or buttons
        if ($content -match 'confirm=([0-9A-Za-z_\-]+)' -or $content -match 'name="confirm" value="([0-9A-Za-z_\-]+)"') {
            $confirmToken = $matches[1]
            Write-Log "Confirm token found ($confirmToken). Re-requesting direct file stream..."
            $confirmUrl = "$baseUrl&confirm=$confirmToken"
            $wc.DownloadFile($confirmUrl, $tempZip)
        } else {
            # Secondary fallback for large drive downloads
            $confirmUrl = "$baseUrl&confirm=t"
            Write-Log "Attempting forced confirmation download..."
            $wc.DownloadFile($confirmUrl, $tempZip)
        }
    }

    if ((Get-Item $tempZip).Length -lt 1000) {
        throw "Downloaded file is empty or invalid. Check Google Drive permissions."
    }
    
    Write-Log "Download successful. Size: $((Get-Item $tempZip).Length) bytes."
} catch {
    Write-Log "ERROR: Download failed. $_"
    Remove-Item -Path $tempZip -Force -ErrorAction SilentlyContinue
    exit 1
}

# -----------------------------------------------------------------------------
# 3. Extract ZIP and Move Specific Items to Destination
# -----------------------------------------------------------------------------
try {
    Write-Log "Extracting ZIP contents..."
    Expand-Archive -Path $tempZip -DestinationPath $tempExtract -Force

    foreach ($itemName in $TargetItems) {
        # Search extracted folder recursively for target items
        $foundItems = Get-ChildItem -Path $tempExtract -Filter $itemName -Recurse -ErrorAction SilentlyContinue

        if ($foundItems) {
            foreach ($item in $foundItems) {
                $targetDest = Join-Path $DestinationFolder $item.Name
                Write-Log "Deploying: $($item.Name) -> $targetDest"
                
                if ($item.PSIsContainer) {
                    Copy-Item -Path $item.FullName -Destination $DestinationFolder -Recurse -Force
                } else {
                    Copy-Item -Path $item.FullName -Destination $targetDest -Force
                }
            }
        } else {
            Write-Log "WARNING: Expected item '$itemName' was not found in the ZIP package."
        }
    }

    Write-Log "Deployment completed successfully!"
    exit 0
} catch {
    Write-Log "ERROR: Extraction or deployment failed. $_"
    exit 3
} finally {
    # Cleanup temporary items
    Remove-Item -Path $tempZip -Force -ErrorAction SilentlyContinue
    Remove-Item -Path $tempExtract -Recurse -Force -ErrorAction SilentlyContinue
}
