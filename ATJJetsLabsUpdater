# =============================================================================
# Deploy-GarminData.ps1 (Deep Freeze Cloud / SYSTEM Context Optimized)
# =============================================================================
$ErrorActionPreference = "Stop"
$ProgressPreference    = "SilentlyContinue"

# Force TLS 1.2 / TLS 1.3
try {
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 -bor [Net.SecurityProtocolType]::Tls13
} catch { }

function Write-Log {
    param([string]$Message)
    Write-Output "[$((Get-Date).ToString('yyyy-MM-dd HH:mm:ss'))] $Message"
}

# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------
$DestinationFolder = "C:\X-Plane 12\Custom Data"
$DownloadUrl       = "https://raw.githubusercontent.com/anthonyguthrie-create/ATPJetsLabsUpdater/main/NAVDB.zip"

# Targeted items to extract and deploy
$TargetItems = @(
    "CIFP",
    "earth_fix.dat",
    "earth_awy.dat",
    "earth_nav.dat",
    "earth_hold.dat",
    "earth_mora.dat",
    "earth_msa.dat"
)

# Parse argument list passed via Deep Freeze Cloud
if ($args.Count -gt 0) {
    $rawArgs = $args -join " "
    if ($rawArgs -match '(https?://[^\s"]+)') {
        $DownloadUrl = $matches[1]
    }
}

# Clean HTML-encoded characters if passed by agent
Add-Type -AssemblyName System.Web
$DownloadUrl = [System.Web.HttpUtility]::HtmlDecode($DownloadUrl)

Write-Log "Starting deployment to: $DestinationFolder"
Write-Log "Sanitized Download URL : $DownloadUrl"

# -----------------------------------------------------------------------------
# 1. Ensure Target Directory Exists
# -----------------------------------------------------------------------------
try {
    if (-not (Test-Path -LiteralPath $DestinationFolder)) {
        Write-Log "Creating destination directory: $DestinationFolder"
        New-Item -Path $DestinationFolder -ItemType Directory -Force | Out-Null
    }
} catch {
    Write-Log "ERROR: Failed to create target directory. $_"
    exit 2
}

# Setup temp paths
$tempZip     = Join-Path $env:TEMP ("gh_" + [Guid]::NewGuid().ToString("N") + ".zip")
$tempExtract = Join-Path $env:TEMP ("extract_" + [Guid]::NewGuid().ToString("N"))

# -----------------------------------------------------------------------------
# 2. Redirect-Aware Background Download (HttpClient)
# -----------------------------------------------------------------------------
try {
    Write-Log "Downloading ZIP package..."
    
    # Use System.Net.Http.HttpClient to properly follow GitHub 302 redirects
    Add-Type -AssemblyName System.Net.Http
    $handler = New-Object System.Net.Http.HttpClientHandler
    $handler.AllowAutoRedirect = $true
    
    $client = New-Object System.Net.Http.HttpClient($handler)
    $client.DefaultRequestHeaders.Add("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64)")
    
    $response = $client.GetAsync($DownloadUrl).Result
    if (-not $response.IsSuccessStatusCode) {
        throw "Server returned HTTP status code: $($response.StatusCode)"
    }

    $fileStream = [System.IO.File]::Create($tempZip)
    $response.Content.CopyToAsync($fileStream).Wait()
    $fileStream.Close()
    $client.Dispose()

    $fileSize = (Get-Item $tempZip).Length
    
    # Verify file payload isn't 0 bytes or an empty header
    if ($fileSize -lt 1000) {
        throw "Downloaded file is invalid or corrupt ($fileSize bytes)."
    }
    
    Write-Log "Download successful. Size: $fileSize bytes."
} catch {
    Write-Log "ERROR: Download failed. $_"
    Remove-Item -Path $tempZip -Force -ErrorAction SilentlyContinue
    exit 1
}

# -----------------------------------------------------------------------------
# 3. Extract Archive & Copy Selected Items
# -----------------------------------------------------------------------------
try {
    Write-Log "Extracting ZIP contents..."
    Expand-Archive -Path $tempZip -DestinationPath $tempExtract -Force

    foreach ($itemName in $TargetItems) {
        # Recurse extraction folder to find items regardless of subfolder layout
        $foundItems = Get-ChildItem -Path $tempExtract -Filter $itemName -Recurse -ErrorAction SilentlyContinue

        if ($foundItems) {
            foreach ($item in $foundItems) {
                $targetDest = Join-Path $DestinationFolder $item.Name
                Write-Log "Deploying: $($item.Name) -> $targetDest"
                
                if ($item.PSIsContainer) {
                    Copy-Item -Path $item.FullName -Destination $DestinationFolder -Recurse -Force
                } else {
                    Copy-Item -Path $item.FullName -Destination $targetDest -Force
                }
            }
        } else {
            Write-Log "WARNING: Expected item '$itemName' was not found in the ZIP package."
        }
    }

    Write-Log "Deployment completed successfully!"
    exit 0
} catch {
    Write-Log "ERROR: Extraction or deployment failed. $_"
    exit 3
} finally {
    # Clean temporary files
    Remove-Item -Path $tempZip -Force -ErrorAction SilentlyContinue
    Remove-Item -Path $tempExtract -Recurse -Force -ErrorAction SilentlyContinue
}
