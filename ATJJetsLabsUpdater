# =============================================================================
# Deploy-GarminData.ps1 (Deep Freeze Cloud / SYSTEM Context Optimized)
# =============================================================================
$ErrorActionPreference = "Stop"
$ProgressPreference    = "SilentlyContinue"

# Force TLS 1.2
try {
    [Net.ServicePointManager]::SecurityProtocol = `
        [Net.SecurityProtocolType]::Tls12 -bor [Net.SecurityProtocolType]::Tls13
} catch { }

function Write-Log {
    param([string]$Message)
    Write-Output "[$((Get-Date).ToString('yyyy-MM-dd HH:mm:ss'))] $Message"
}

# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------
$DestinationFolder = "C:\X-Plane 12\Custom Data"
$DefaultUrl        = "https://drive.google.com/uc?export=download&id=1CHt_W9PP_nhhO1YbPV8fjGno39C-V5Hh&confirm=t"
$DownloadUrl       = $DefaultUrl

# Targeted files and directories to copy
$TargetItems = @(
    "CIFP",
    "earth_fix.dat",
    "earth_awy.dat",
    "earth_nav.dat",
    "earth_hold.dat",
    "earth_mora.dat",
    "earth_msa.dat"
)

# Parse -DownloadUrl passed via Deep Freeze Cloud command line arguments
for ($i = 0; $i -lt $args.Count; $i++) {
    if ($args[$i] -eq "-DownloadUrl" -and ($i + 1) -lt $args.Count) {
        $DownloadUrl = $args[$i + 1]
    }
}

# Sanitize HTML-encoded ampersands (&amp; -> &) passed by management agents
Add-Type -AssemblyName System.Web
$DownloadUrl = [System.Web.HttpUtility]::HtmlDecode($DownloadUrl)

Write-Log "Starting deployment to: $DestinationFolder"
Write-Log "Sanitized Download URL: $DownloadUrl"

# -----------------------------------------------------------------------------
# 1. Ensure Target Directory Exists
# -----------------------------------------------------------------------------
try {
    if (-not (Test-Path -LiteralPath $DestinationFolder)) {
        Write-Log "Creating destination directory: $DestinationFolder"
        New-Item -Path $DestinationFolder -ItemType Directory -Force | Out-Null
    }
} catch {
    Write-Log "ERROR: Failed to create target directory. $_"
    exit 2
}

# Setup temporary paths for download and extraction
$tempZip     = Join-Path $env:TEMP ("gdrive_" + [Guid]::NewGuid().ToString("N") + ".zip")
$tempExtract = Join-Path $env:TEMP ("extract_" + [Guid]::NewGuid().ToString("N"))

# -----------------------------------------------------------------------------
# 2. Download ZIP from Google Drive
# -----------------------------------------------------------------------------
try {
    Write-Log "Downloading ZIP file from Google Drive..."
    
    # Use Invoke-WebRequest / System.Net.HttpWebRequest handling
    $wc = New-Object System.Net.WebClient
    $wc.Headers.Add("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64)")
    $wc.DownloadFile($DownloadUrl, $tempZip)

    # Check file size to detect HTML warning responses or auth failures
    $fileInfo = Get-Item $tempZip
    if ($fileInfo.Length -lt 10000) {
        $content = [System.IO.File]::ReadAllText($tempZip)
        
        # If Google Drive returns a secondary confirmation token prompt
        if ($content -match 'confirm=([0-9A-Za-z_\-]+)') {
            $confirmToken = $matches[1]
            Write-Log "Confirm token required ($confirmToken). Re-requesting direct file stream..."
            
            if ($DownloadUrl -match 'confirm=') {
                $confirmUrl = $DownloadUrl -replace 'confirm=[^&]*', "confirm=$confirmToken"
            } else {
                $confirmUrl = "$DownloadUrl&confirm=$confirmToken"
            }
            
            $wc.DownloadFile($confirmUrl, $tempZip)
        }
    }

    $finalSize = (Get-Item $tempZip).Length
    if ($finalSize -lt 1000) {
        # Read small error content for diagnostic logging
        $errDetails = [System.IO.File]::ReadAllText($tempZip)
        if ($errDetails.Length -gt 250) { $errDetails = $errDetails.Substring(0, 250) + "..." }
        throw "Downloaded file is invalid ($finalSize bytes). Response snippet: $errDetails"
    }

    Write-Log "Download successful. Size: $finalSize bytes."
} catch {
    Write-Log "ERROR: Download failed. $_"
    Remove-Item -Path $tempZip -Force -ErrorAction SilentlyContinue
    exit 1
}

# -----------------------------------------------------------------------------
# 3. Extract Archive & Copy Specific Items
# -----------------------------------------------------------------------------
try {
    Write-Log "Extracting ZIP contents to temporary directory..."
    Expand-Archive -Path $tempZip -DestinationPath $tempExtract -Force

    # Process targeted files and folders
    foreach ($itemName in $TargetItems) {
        # Recurse through extraction folder to locate the target item regardless of subfolder structure
        $foundItems = Get-ChildItem -Path $tempExtract -Filter $itemName -Recurse -ErrorAction SilentlyContinue

        if ($foundItems) {
            foreach ($item in $foundItems) {
                $targetDest = Join-Path $DestinationFolder $item.Name
                Write-Log "Deploying: $($item.Name) -> $targetDest"
                
                if ($item.PSIsContainer) {
                    # Copy directory recursively with overwrite
                    Copy-Item -Path $item.FullName -Destination $DestinationFolder -Recurse -Force
                } else {
                    # Copy single file with overwrite
                    Copy-Item -Path $item.FullName -Destination $targetDest -Force
                }
            }
        } else {
            Write-Log "WARNING: Expected item '$itemName' was not found in the downloaded ZIP package."
        }
    }

    Write-Log "Deployment completed successfully!"
} catch {
    Write-Log "ERROR: Extraction or file deployment failed. $_"
    exit 3
} finally {
    # Cleanup temporary paths
    Remove-Item -Path $tempZip -Force -ErrorAction SilentlyContinue
    Remove-Item -Path $tempExtract -Recurse -Force -ErrorAction SilentlyContinue
}

exit 0
