# =============================================================================
# Deploy-GarminData-Release.ps1 (Deep Freeze Cloud / SYSTEM Context)
# =============================================================================
$ErrorActionPreference = "Stop"
$ProgressPreference    = "SilentlyContinue"

# Force TLS 1.2
try {
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
} catch { }

function Write-Log {
    param([string]$Message)
    Write-Output "[$((Get-Date).ToString('yyyy-MM-dd HH:mm:ss'))] $Message"
}

# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------
$DestinationFolder = "C:\X-Plane 12\Custom Data"
$DownloadUrl       = "https://github.com/anthonyguthrie-create/ATPJetsLabsUpdater/releases/download/V1.0/NavDB.zip"

$TargetItems = @(
    "CIFP",
    "earth_fix.dat",
    "earth_awy.dat",
    "earth_nav.dat",
    "earth_hold.dat",
    "earth_mora.dat",
    "earth_msa.dat"
)

# Parse argument list passed via Deep Freeze Cloud
if ($args.Count -gt 0) {
    $rawArgs = $args -join " "
    if ($rawArgs -match '(https?://[^\s"]+)') {
        $DownloadUrl = $matches[1]
    }
}

Add-Type -AssemblyName System.Web
$DownloadUrl = [System.Web.HttpUtility]::HtmlDecode($DownloadUrl)

Write-Log "Starting deployment (GitHub Release) to: $DestinationFolder"
Write-Log "Target Download URL: $DownloadUrl"

# -----------------------------------------------------------------------------
# 1. Directory Check
# -----------------------------------------------------------------------------
if (-not (Test-Path -LiteralPath $DestinationFolder)) {
    Write-Log "Creating destination directory: $DestinationFolder"
    New-Item -Path $DestinationFolder -ItemType Directory -Force | Out-Null
}

$tempZip     = Join-Path $env:TEMP ("ghrel_" + [Guid]::NewGuid().ToString("N") + ".zip")
$tempExtract = Join-Path $env:TEMP ("extract_" + [Guid]::NewGuid().ToString("N"))

# -----------------------------------------------------------------------------
# 2. Download via Native curl.exe (with Automatic Case Fallback)
# -----------------------------------------------------------------------------
try {
    Write-Log "Downloading ZIP package from GitHub Release..."
    
    # Primary attempt
    & curl.exe -s -L -k -H "Accept: application/octet-stream" -o "$tempZip" "$DownloadUrl"

    # Check if download returned a valid ZIP header (PK..)
    $bytes = Get-Content -Path $tempZip -Encoding Byte -TotalCount 2 -ErrorAction SilentlyContinue
    if (-not ($bytes[0] -eq 0x50 -and $bytes[1] -eq 0x4B)) {
        
        # Build alternate URL by swapping tag case (v1.0 <-> V1.0)
        $altUrl = ""
        if ($DownloadUrl -match '/download/v1.0/') {
            $altUrl = $DownloadUrl -replace '/download/v1.0/', '/download/V1.0/'
        } elseif ($DownloadUrl -match '/download/V1.0/') {
            $altUrl = $DownloadUrl -replace '/download/V1.0/', '/download/v1.0/'
        }

        if ($altUrl) {
            Write-Log "Initial case failed. Retrying with alternate tag case URL: $altUrl"
            & curl.exe -s -L -k -H "Accept: application/octet-stream" -o "$tempZip" "$altUrl"
            $bytes = Get-Content -Path $tempZip -Encoding Byte -TotalCount 2 -ErrorAction SilentlyContinue
        }
    }

    $fileSize = (Get-Item $tempZip).Length
    
    # Final Magic Header check
    if (-not ($bytes[0] -eq 0x50 -and $bytes[1] -eq 0x4B)) {
        $rawText = [System.IO.File]::ReadAllText($tempZip)
        throw "Server response: '$rawText' ($fileSize bytes). Verify repository visibility (must be Public) or tag spelling."
    }

    Write-Log "Download completed successfully. ZIP Size: $fileSize bytes."
} catch {
    Write-Log "ERROR: Download failed. Details: $_"
    Remove-Item -Path $tempZip -Force -ErrorAction SilentlyContinue
    exit 1
}

# -----------------------------------------------------------------------------
# 3. Extract Archive & Deploy Items
# -----------------------------------------------------------------------------
try {
    Write-Log "Extracting ZIP contents..."
    Expand-Archive -Path $tempZip -DestinationPath $tempExtract -Force

    foreach ($itemName in $TargetItems) {
        $foundItems = Get-ChildItem -Path $tempExtract -Filter $itemName -Recurse -ErrorAction SilentlyContinue

        if ($foundItems) {
            foreach ($item in $foundItems) {
                $targetDest = Join-Path $DestinationFolder $item.Name
                Write-Log "Deploying: $($item.Name) -> $targetDest"
                
                if ($item.PSIsContainer) {
                    Copy-Item -Path $item.FullName -Destination $DestinationFolder -Recurse -Force
                } else {
                    Copy-Item -Path $item.FullName -Destination $targetDest -Force
                }
            }
        } else {
            Write-Log "WARNING: Item '$itemName' was not found in the ZIP package."
        }
    }

    Write-Log "Deployment completed successfully!"
    exit 0
} catch {
    Write-Log "ERROR: Extraction or deployment failed. $_"
    exit 3
} finally {
    Remove-Item -Path $tempZip -Force -ErrorAction SilentlyContinue
    Remove-Item -Path $tempExtract -Recurse -Force -ErrorAction SilentlyContinue
}
